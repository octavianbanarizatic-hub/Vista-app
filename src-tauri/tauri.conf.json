{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vista",
  "version": "0.5.0",
  "identifier": "dev.vista.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vista",
        "width": 480,
        "height": 900,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: media: http://media.localhost",
        "media-src": "'self' blob: media: http://media.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost media: http://media.localhost ws://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
