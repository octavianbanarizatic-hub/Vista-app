<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep playing with the screen off (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the processor and Wi-Fi awake while streaming with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Whether the connection is metered (prepare fewer videos, download on Wi-Fi). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- App updates: Android's installer opens the downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New video notifications (NewVideos); Android 13 and newer ask first. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.vista.android.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
